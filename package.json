{
  "name": "flashcards-literacy-app",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --parallel --stream --filter app --filter api dev",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test && pnpm test:scripts",
    "test:scripts": "node --import tsx --test --test-concurrency=1 scripts/*.test.ts",
    "content:validate": "tsx scripts/content-validate.ts",
    "audio:manifest": "tsx scripts/audio-manifest.ts",
    "audio:manifest:check": "tsx scripts/audio-manifest.ts --check",
    "audio:stage": "tsx scripts/audio-stage.ts",
    "replay:attempts": "tsx scripts/replay-attempts.ts",
    "db:migrations:list": "wrangler d1 migrations list literacy_preview --config api/wrangler.toml"
  },
  "devDependencies": {
    "playwright": "^1.60.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.92.0"
  }
}
